# Server
PORT=3000
NODE_ENV=development

# PostgreSQL (local: use full URL | production: automatically set by Railway)
DATABASE_URL=postgresql://localhost:5432/rlaas

# Redis (local: use host+port | production: set REDIS_URL from Railway)
REDIS_URL=
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# JWT Secret (generate a strong random string for production)
JWT_SECRET=your_jwt_secret_here

# CORS — set to your Vercel frontend URL in production
CLIENT_URL=https://your-app.vercel.app
