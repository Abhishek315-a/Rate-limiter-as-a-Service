PORT=3000

# PostgreSQL (local: use full URL | production: set by Railway automatically)
DATABASE_URL=postgresql://localhost:5432/rlaas

# Redis (local: use host+port | production: set REDIS_URL from Railway)
REDIS_URL=
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# JWT
JWT_SECRET=your_jwt_secret_here

# App
NODE_ENV=development

# CORS — set to your Vercel frontend URL in production
# CLIENT_URL=https://your-app.vercel.app
