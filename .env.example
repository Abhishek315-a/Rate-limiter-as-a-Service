# Server
PORT=3000
NODE_ENV=development

# PostgreSQL
# Local:      postgresql://localhost:5432/rlaas
# Render:     copy the Internal Database URL from your Render Postgres service
DATABASE_URL=postgresql://localhost:5432/rlaas

# Redis
# Local:      leave REDIS_URL empty and set REDIS_HOST / REDIS_PORT
# Upstash:    set REDIS_URL to your Upstash Redis URL (starts with rediss://)
#             REDIS_HOST / REDIS_PORT / REDIS_PASSWORD are ignored when REDIS_URL is set
REDIS_URL=
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# JWT Secret — generate a strong random string for production:
#   openssl rand -base64 32
JWT_SECRET=your_jwt_secret_here

# CORS — set to your Vercel frontend URL in production (no trailing slash)
CLIENT_URL=https://rate-limiter-as-a-service-mu.vercel.app
